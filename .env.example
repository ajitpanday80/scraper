GOOGLE_PLACES_API_KEY=
ADMIN_USER=admin
ADMIN_PASSWORD=
SECRET_KEY=
# set to 1 when served over HTTPS
COOKIE_SECURE=0
# hard stop on Google API requests per (UTC) day, to cap your bill
MAX_API_CALLS_PER_DAY=300
# optional: where the SQLite database lives
DB_PATH=places.db

# --- campaigns ---
# AI drafting through OpenRouter (https://openrouter.ai). Pick any model slug from their model list.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Times shown and used for sending windows
TIMEZONE=Asia/Kolkata
# Earliest start and latest end of any daily sending window
SEND_WINDOW_LIMIT=09:00-21:00
# Hard ceiling for "messages per hour" on any campaign
MAX_PER_HOUR=120
# Where attachments are stored
UPLOAD_DIR=uploads

# --- WhatsApp (wa-bridge) ---
# Shared secret between the app and the bridge; put the same value in /etc/wa-bridge/env
WA_BRIDGE_TOKEN=
WA_BRIDGE_URL=http://127.0.0.1:3399
# Seconds between WhatsApp messages (random in this range, shared by all WhatsApp campaigns)
WA_GAP_MIN=180
WA_GAP_MAX=240
# Daily cap per linked number; WA_WARMUP=0 turns off the new-number ramp (10/20/30/50 a day)
WA_MAX_PER_DAY=50
WA_WARMUP=1

# --- MyTiffin directory push (optional) ---
MYTIFFIN_API_KEY=
MYTIFFIN_URL=https://mytiffin.online
